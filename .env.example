# Personal profile applied to new projects by `script/new-project.sh`.
#
# Copy this file to `.env` and fill in your own values.
# Scaffolds themselves stay generic/vanilla and use `%%VAR%%` placeholders.
# Without a `.env`, new-project.sh leaves those placeholders
# as-is in the copy so you can fill them in by hand instead.

# ---------- Author

AUTHOR_FIRSTNAME=John
AUTHOR_LASTNAME=Doe
AUTHOR_GENDER=male # male | female
AUTHOR_LOCALITY=City

# ---------- Entity (school, employer...)

ENTITY_NAME="Your Institution"
ENTITY_ACRONYM="Acronym"
ENTITY_LOCALITY=City

# ---------- Programme (section, orientation/profile...)

SECTION_NAME="Your programme"
SECTION_ACRONYM="Acronym"
PROFILE_NAME="Your orientation/profile"
PROFILE_ACRONYM="Acronym"

# ---------- Logos

# Space-separated paths (absolute, or relative to this repo's root) to your own logo files.
LOGO_PATHS="/path/to/logo1.svg /path/to/logo2.png"
